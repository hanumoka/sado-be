meta {
  name: WADO-RS Retrieve Instance
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/dicomweb/studies/{{studyUID}}/series/{{seriesUID}}/instances/{{sopInstanceUID}}
  body: none
